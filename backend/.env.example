# Copy this file to `backend/.env` before starting the API.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env

ENVIRONMENT=local
DEBUG=true

# Must match the credentials/port in the root .env used by docker-compose.
# Note the "+asyncpg" driver suffix -- it is required.
DATABASE_URL=postgresql+asyncpg://alyf:alyf@localhost:5432/alyf

# Length of the embedding vectors stored in PostgreSQL. Changing this after
# tables exist requires dropping the `facts` table (see README, Troubleshooting).
EMBEDDING_DIMENSIONS=384

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Google Document AI, used to OCR PDFs (app/ingestion/ocr.py, plus the
# scripts/check_document_ai.py and scripts/ocr_pdf.py scripts). Also requires
# GOOGLE_APPLICATION_CREDENTIALS (a service account key file path) to be set
# as a real OS environment variable — it is not read from this file.
DOCAI_PROJECT_ID=your-gcp-project-id
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your-processor-id

# Cloud Storage bucket used as scratch space for PDFs too long for online
# processing (see app/ingestion/ocr.py, ONLINE_PAGE_LIMIT). Document AI's
# batch API reads its input from here and writes its output back here; ALYF
# deletes both once it has read the result. Only needed if you expect PDFs
# over that page count -- leave blank otherwise.
DOCAI_GCS_BUCKET=

# Resend (https://resend.com/signup -- free tier, no card required), used to
# send weekly roadmap reminder emails (scripts/send_roadmap_reminders.py).
# Create an API key at resend.com/api-keys. The default sender below is
# Resend's own sandbox address and works with no setup; point it at your own
# verified domain once you have one.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used to build the "view your report" link in reminder emails, and where
# Google OAuth sends inspectors back to after login (see below). Point this
# at the real frontend URL once deployed -- it is never read by the browser,
# so it does not need the NEXT_PUBLIC_ prefix frontend/.env.local uses.
FRONTEND_BASE_URL=http://localhost:3000

# Inspector accounts (see README, "Inspector accounts"). JWT_SECRET signs the
# session cookie -- anyone who has it can mint a session for any inspector,
# so change this in any real deployment. The default below works immediately
# for local dev with no setup.
JWT_SECRET=dev-secret-change-me-in-any-real-deployment-32bytes
JWT_EXPIRES_DAYS=14
AUTH_COOKIE_NAME=alyf_session
COOKIE_SECURE=false

# Sign in with Google (see README, "Sign in with Google"). Left blank, Google
# login responds with a clear "not configured" error rather than a broken
# redirect -- password login/signup work fine without any of this set.
# SESSION_SECRET backs Starlette's SessionMiddleware (the OAuth redirect's
# transient state/nonce), separate from JWT_SECRET above.
SESSION_SECRET=dev-session-secret-change-me-in-any-real-deployment
BACKEND_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
