# Copy this file to `.env` (same folder) before running `docker compose up -d`.
# These values are read by docker-compose.yml.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env

POSTGRES_USER=alyf
POSTGRES_PASSWORD=alyf
POSTGRES_DB=alyf

# Host port the database is published on. Change this (e.g. 5433) if you already
# have PostgreSQL running locally on 5432. If you change it, also update
# DATABASE_URL in backend/.env
POSTGRES_PORT=5432

# Host port for the optional Adminer database UI.
ADMINER_PORT=8080
