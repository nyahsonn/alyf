# Copy this file to `frontend/.env.local` before running `npm run dev`.
#
#   Windows PowerShell:  Copy-Item .env.local.example .env.local
#   macOS / Linux:       cp .env.local.example .env.local
#
# Where the FastAPI backend is listening. NEXT_PUBLIC_ means the value is
# embedded in the browser bundle -- never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Error monitoring (see README, "Error monitoring"). A DSN isn't a secret --
# it's meant to ship in client-side bundles -- so NEXT_PUBLIC_ is correct
# here, unlike an API key. Use a SEPARATE Sentry project from the backend's:
# mixing frontend and backend events into one project makes alerts harder
# to read (a Next.js hydration error and a Claude API failure look nothing
# alike). Left blank, Sentry.init still runs but has nothing to send to.
NEXT_PUBLIC_SENTRY_DSN=
